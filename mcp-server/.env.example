# URL base de la API de Huellitas Solidarias.
# Solo se aceptan http/https; por defecto apunta a producción.
HUELLITAS_API_URL=https://api.huellitassolidarias.com

# =============================================================================
# Solo para el modo LOCAL por stdio (npm start / dev). En modo remoto HTTP
# (ver mas abajo) NO se usa nada de esto: cada persona mete su propio correo
# y contraseña al conectarse (rama main), o el servidor usa una cuenta de
# servicio compartida (rama mcp-admin-full-access).
# =============================================================================

# (Opcional) Token JWT fijo para habilitar las tools que requieren
# autenticación (usuarios, solicitudes, donaciones, reportes de rescate).
# El alcance real de los datos lo decide el rol del token en el backend.
# Se lee SOLO de aquí: nunca se acepta como parámetro de una tool.
# Expira en 1h y hay que reemplazarlo a mano — para no depender de eso, usar
# HUELLITAS_ADMIN_EMAIL/HUELLITAS_ADMIN_PASSWORD en su lugar.
HUELLITAS_API_TOKEN=

# (Opcional, alternativa a HUELLITAS_API_TOKEN) Credenciales de una cuenta
# propia (o de servicio) con la que el servidor stdio se loguea solo
# (POST /auth/login) y renueva el token automaticamente antes de que expire.
# Si HUELLITAS_API_TOKEN esta definido, tiene prioridad sobre esto.
HUELLITAS_ADMIN_EMAIL=
HUELLITAS_ADMIN_PASSWORD=

# Interruptor de escritura. En "false" (por defecto) el servidor es de solo
# lectura y ninguna tool puede modificar datos.
MCP_ALLOW_WRITES=false

# =============================================================================
# Solo para el modo remoto (npm run start:http / dev:http).
#
# En esta rama (main), cada persona que se conecta ingresa SU PROPIO correo y
# contraseña de Huellitas Solidarias en una pantalla de login — no hay
# passcode de equipo ni claves de API fijas compartidas. El rol real de esa
# cuenta (usuario/fundación/admin) es el que decide, via el backend, que
# puede ver o hacer. Ver src/auth/userLoginOAuthProvider.ts.
#
# (La rama mcp-admin-full-access sí usa MCP_ACCESS_PASSCODE y
# MCP_STATIC_API_KEYS para un acceso administrativo compartido por el
# equipo; ese modelo no aplica aquí.)
# =============================================================================

# Puerto donde escucha el servidor HTTP.
PORT=3002

# URL publica COMPLETA por la que se llega al endpoint MCP, incluida la ruta.
# Debe ser https salvo en localhost.
MCP_PUBLIC_URL=https://huellitassolidarias.com/mcp

# Origenes de navegador permitidos a llamar el endpoint MCP (separados por
# coma). Clientes que no son navegador (Claude Desktop) no mandan Origin, asi
# que esta lista no los afecta.
MCP_ALLOWED_ORIGINS=https://claude.ai
