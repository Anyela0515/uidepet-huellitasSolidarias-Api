# URL base de la API de Huellitas Solidarias.
# Solo se aceptan http/https; por defecto apunta a producción.
HUELLITAS_API_URL=https://api.huellitassolidarias.com

# (Opcional) Token JWT fijo para habilitar las tools que requieren
# autenticación (usuarios, solicitudes, donaciones, reportes de rescate).
# El alcance real de los datos lo decide el rol del token en el backend.
# Se lee SOLO de aquí: nunca se acepta como parámetro de una tool.
# Expira en 1h y hay que reemplazarlo a mano — para no depender de eso, usar
# HUELLITAS_ADMIN_EMAIL/HUELLITAS_ADMIN_PASSWORD en su lugar (ver abajo).
HUELLITAS_API_TOKEN=

# (Opcional, alternativa a HUELLITAS_API_TOKEN) Credenciales de una cuenta de
# servicio con la que el propio servidor se loguea solo (POST /auth/login) y
# renueva el token automaticamente antes de que expire. Si HUELLITAS_API_TOKEN
# esta definido, tiene prioridad sobre esto.
HUELLITAS_ADMIN_EMAIL=
HUELLITAS_ADMIN_PASSWORD=

# Interruptor de escritura. En "false" (por defecto) el servidor es de solo
# lectura y ninguna tool puede modificar datos.
MCP_ALLOW_WRITES=false

# =============================================================================
# Solo para el modo remoto (npm run start:http / dev:http). El modo local por
# stdio (npm start / dev) no usa nada de lo de abajo.
# =============================================================================

# Puerto donde escucha el servidor HTTP.
PORT=3002

# URL publica COMPLETA por la que se llega al endpoint MCP, incluida la ruta.
# Debe ser https salvo en localhost. Se usa como "resource" del token OAuth y
# para armar los metadatos de descubrimiento.
MCP_PUBLIC_URL=https://huellitassolidarias.com/mcp

# Clave compartida del equipo para autorizar la conexion (pantalla de login
# antes de emitir el codigo OAuth). Generar un valor largo y aleatorio, por
# ejemplo con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_ACCESS_PASSCODE=

# Origenes de navegador permitidos a llamar el endpoint MCP (separados por
# coma). Clientes que no son navegador (Claude Desktop) no mandan Origin, asi
# que esta lista no los afecta.
MCP_ALLOWED_ORIGINS=https://claude.ai

# (Opcional) Claves de API fijas, separadas por coma, para clientes que no
# hacen el login OAuth interactivo y solo pueden mandar un bearer token
# constante desde su propio entorno (p. ej. Codex). No expiran: revocar una
# es quitarla de esta lista y reiniciar el servidor. Generar cada una con:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
MCP_STATIC_API_KEYS=
